{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialguard-ui",
  "compatibility_date": "2026-09-28",
  "routes": [{ "pattern": "guard.utf.lol", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
