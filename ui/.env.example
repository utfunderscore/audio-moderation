# Copy to .env.local and fill in a deployed stack's endpoints. Read them from
# Terraform's local state:
#   terraform -chdir=../terraform output -raw api_endpoint
#   terraform -chdir=../terraform output -raw pipeline_task_events_websocket_endpoint
#
# Vite expands $VAR references in env files, so escape the API Gateway
# $default stage as \$default or the stage segment is dropped from the URL.
VITE_API_ENDPOINT=https://<api-id>.execute-api.<region>.amazonaws.com/
VITE_TASK_EVENTS_ENDPOINT=wss://<ws-api-id>.execute-api.<region>.amazonaws.com/\$default
