# Copy to .env.local and fill in a deployed stack's endpoints. Read them from
# Terraform's local state:
#   AWS_PROFILE=admin terraform -chdir=../terraform output -raw api_endpoint
#   AWS_PROFILE=admin terraform -chdir=../terraform output -raw pipeline_task_events_websocket_endpoint
#
# With the repository's Cloudflare proxy defaults, the outputs resolve to:
VITE_API_ENDPOINT=https://api-guard.utf.lol
VITE_TASK_EVENTS_ENDPOINT=wss://events-guard.utf.lol
# Public sitekey comes from Terraform's turnstile_sitekey output. The deployment
# runner writes it to ignored .env.local and .env.production.local after apply.
# The widget must allow the UI hostname. Never put the secret in VITE_* variables.
VITE_TURNSTILE_SITE_KEY=
# Optional (defaults to submit_review); only override for a matching backend test action.
# VITE_TURNSTILE_ACTION=test
